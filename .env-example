# v2 2026-07-09 @rew62
# Keys/values written unquoted -- the widgets' .env parsers keep quote chars.
# enigma-config.sh generates the real .env; this file mirrors what it writes.
OWM_API_KEY=your_openweathermap_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
CITY_ID=5128581
UNITS=imperial
LAT=40.71280
LON=-74.00600
INTERFACE_NAME=wlp2s0
DISK_DEV=nvme0n1
# Optional: force a specific NWS observation station (default: nearest)
# NWS_STATION=KIAD
