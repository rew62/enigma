#!/usr/bin/env bash
# v1 2026-07-04 @rew62

SESSION="conky"
PANES_PER_WINDOW=4

# --- Resolve base directory of this script ---
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Sample wallpaper luminance for theme.lua bg_alpha ---
"$BASE_DIR/scripts/sample-luma.sh"

# --- 150px widget positioning: gap_x vs border_inner_margin ---
# border_inner_margin only inflates the window around conky.text content —
# it does nothing for pure-lua widgets (empty conky.text, drawn via
# lua_draw_hook), since there's no text bounding box for it to act on.
# Two rules apply depending on widget type, both landing on the same
# final 154px window and the same screen position:
#   - conky.text widgets: minimum_width=150, border_inner_margin=2
#       -> gap_x = base + 2   (e.g. 175 when base=173)
#   - pure-lua widgets:    minimum_width=154, border_inner_margin=0
#       -> gap_x = base       (e.g. 173)
# The two gap_x values always differ by exactly the margin amount (2px).

# --- Code → "dir|rcfile" map (single source of truth) ---
declare -A MAP

MAP[a]="widgets|arc.rc"
MAP[auzia]="~/.conky/auzia-conky|auzia.rc"
MAP[c]="widgets|multimon.rc"
MAP[e]="widgets|enigma-earth.lua"
MAP[ec]="widgets|espcal.lua"
MAP[ecg]="widgets|nsd2.lua"
MAP[ed]="widgets|disk.rc"
MAP[eg]="widgets|nsd.lua"
MAP[em]="widgets|worldmap.rc"
MAP[en]="widgets|network.rc"
MAP[eq]="music2|eq.rc"
MAP[es]="widgets|system.rc"
MAP[ev]="widgets|vnstat-summary.rc"
MAP[g]="widgets|gcal.rc"
MAP[m]="music2|nowplaying.rc"
MAP[mp]="widgets|playerctl.rc"
MAP[msi]="widgets|song-info.rc"
MAP[r]="widgets|rss.rc"
MAP[sd]="widgets|solar_dial2.lua"
MAP[si]="widgets|indices2.rc"
MAP[st]="widgets|ticker.rc"
MAP[t]="widgets|alien-clock2.lua"
MAP[wf]="widgets|nws_forecast_small.rc"
MAP[wt]="widgets|tempbar.rc"
MAP[zen]="utils|enigma-logo.lua"
MAP[zkr]="utils|kroy.lua"
MAP[x-au-m]="~/.conky/conky-aurora/moon|moon.rc"
MAP[x-au-s]="~/.conky/conky-aurora/system|system.rc"

# --- Named groups ---
declare -A NAMED_GROUPS

NAMED_GROUPS[default]="c e ec ed em en es ev g m si wf wt zen"
NAMED_GROUPS[stack1]="a sd st r t zkr"

# --- Help ---
show_help() {
    echo "Usage: $(basename "$0") [codes...]"
    echo ""
    echo "  Codes:"
    echo "    all         launch everything"
    echo "    a           Arc"
    echo "    auzia       Auzia rings"
    echo "    c           Multi-Month Calendar         (150px)"
    echo "    e           Earth                        (150px)"
    echo "    ec          Calendar                     (150px)"
    echo "    ed          Enigma Disk Monitor          (150px)"
    echo "    ecg         Net/Sys/Disk Combo2          (150px)"
    echo "    eg          Net/Sys/Disk Combined        (150px)"
    echo "    em          Enigma World Map             (150px)"
    echo "    en          Enigma Network               (150px)"
    echo "    eq          Spectrum Equalizer (music2)"
    echo "    es          Eniga System                 (150px)"
    echo "    ev          enigma vnstat                (150px)"
    echo "    g           Google Calendar              (150px)"
    echo "    m           Now Playing (music2)         (150px)"
    echo "    mp          Now Playing Sidepanel"
    echo "    msi         Song Info (legacy)"
    echo "    r           RSS"
    echo "    sd          Solar Dial Ring              (200px)"
    echo "    si          Stock Indices                (150px)"
    echo "    st          Stocks                       (150px)"
    echo "    t           Clock (sweep rings)"
    echo "    wf          Weather Forecast             (150px)"
    echo "    wt          Weather Temperature Bar      (150px)"
    echo "    zen         ENIGMA logotype"
    echo "    zkr         killroy was here!"
    echo "    x-au-m      Aurora Moon"
    echo "    x-au-s      Aurora System"
    echo ""
    echo "  Groups:"
    for g in default stack1; do
        printf "    %-12s %s\n" "$g" "${NAMED_GROUPS[$g]}"
    done
    echo ""
    echo "  Example: $(basename "$0") t wc wf a"
    echo ""
    echo "  goto [code]   jump straight to the pane running that widget"
    echo "                (no code: fzf picker over all running panes)"
    echo "  list          list all running panes (session:window.pane, command, title)"
    echo "  quit          kill the entire conky tmux session (or: stop)"
}

# --- Pane lookup (goto): map a running conky pane back to its rc file ---
# pane_current_command/pane_start_command can't tell panes apart (every pane
# just shows "conky"), so the actual -c argument is read off the live conky
# process: pane_pid is the pane's shell, and conky runs as its child.
rc_to_code() {
    local rc="$1" k entry_dir entry_rc
    for k in "${!MAP[@]}"; do
        entry_dir="${MAP[$k]%%|*}"
        entry_rc="${MAP[$k]##*|}"
        [[ "$entry_dir" = ~* ]] && entry_dir="${entry_dir/#\~/$HOME}"
        [[ "$entry_dir" != /* ]] && entry_dir="$BASE_DIR/$entry_dir"
        [[ "$entry_dir/$entry_rc" == "$rc" ]] && { echo "$k"; return; }
    done
}

build_pane_list() {
    tmux list-panes -a -F "#{session_name}:#{window_index}.#{pane_index} #{pane_pid}" 2>/dev/null |
    while read -r target pid; do
        conky_line=$(pgrep -P "$pid" -af conky 2>/dev/null | head -1)
        [ -z "$conky_line" ] && continue
        conky_pid=$(echo "$conky_line" | awk '{print $1}')
        rc=$(echo "$conky_line" | awk '{print $NF}')
        [[ "$rc" != /* ]] && { cwd=$(readlink /proc/"$conky_pid"/cwd 2>/dev/null); rc="$cwd/$rc"; }
        code=$(rc_to_code "$rc")
        printf "%-6s %-28s %s\n" "${code:-?}" "${rc##*/}" "$target"
    done
}

goto_pane() {
    local target="$1"
    tmux select-window -t "$target" 2>/dev/null
    tmux select-pane -t "$target" 2>/dev/null
    if [ -n "$TMUX" ]; then
        tmux switch-client -t "$SESSION"
    else
        tmux attach-session -t "$SESSION"
    fi
}

cmd_goto() {
    local code="$1"

    if ! tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "No session named $SESSION"
        return 1
    fi

    if [ -n "$code" ]; then
        local entry="${MAP[$code]}"
        if [ -z "$entry" ]; then
            echo "Unknown code: $code"
            return 1
        fi
        local rc="${entry##*|}"
        local line target
        line=$(build_pane_list | awk -v code="$code" '$1 == code { print; exit }')
        if [ -z "$line" ]; then
            echo "Not running: $code ($rc) — launch it with: $(basename "$0") $code"
            return 1
        fi
        target=$(echo "$line" | awk '{print $3}')
        goto_pane "$target"
        return 0
    fi

    if ! command -v fzf > /dev/null 2>&1; then
        echo "fzf not found; pass a code instead, e.g. $(basename "$0") goto e"
        build_pane_list
        return 1
    fi

    local sel target
    sel=$(build_pane_list | fzf --prompt="goto> ")
    [ -z "$sel" ] && return 0
    target=$(echo "$sel" | awk '{print $3}')
    goto_pane "$target"
}

# --- Input check ---
if [ "$#" -eq 0 ]; then
    set -- "default"
fi

if [[ "$1" == "help" || "$1" == "--help" || "$1" == "-h" ]]; then
    show_help
    exit 0
fi

# --- Quit ---
if [[ "$1" == "quit" || "$1" == "stop" ]]; then
    tmux kill-session -t "$SESSION" && echo "Killed session: $SESSION" || echo "No session named $SESSION"
    exit
fi

# --- Goto: jump to the pane running a given widget (or fzf-pick one) ---
if [[ "$1" == "goto" ]]; then
    cmd_goto "$2"
    exit $?
fi

# --- List: every running pane, session:window.pane + command + title ---
if [[ "$1" == "list" ]]; then
    if ! tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "No session named $SESSION"
        exit 1
    fi
    printf "%-6s %-28s %s\n" "CODE" "RC" "PANE"
    build_pane_list
    exit $?
fi

# --- Expand "all" to every defined code ---
expanded=()
for arg in "$@"; do
    if [[ "$arg" == "all" ]]; then
        for k in "${!MAP[@]}"; do
            expanded+=("$k")
        done
    elif [[ -n "${NAMED_GROUPS[$arg]}" ]]; then
        read -ra gcodes <<< "${NAMED_GROUPS[$arg]}"
        expanded+=("${gcodes[@]}")
    else
        expanded+=("$arg")
    fi
done
set -- "${expanded[@]}"

# --- Optional bracket parsing ---
if [[ "$1" =~ ^\[.*\]$ ]]; then
    args=$(echo "$1" | tr -d '[]' | tr ',' ' ')
    set -- $args
fi

# --- Remove duplicates ---
declare -A SEEN
FILTERED=()

for code in "$@"; do
    if [[ -z "${SEEN[$code]}" ]]; then
        SEEN[$code]=1
        FILTERED+=("$code")
    fi
done

# Pane shells inherit the tmux *server's* environment. If the server isn't
# running yet, new-session below starts it and it inherits this export; if
# one is already running, its environment predates us, so also publish the
# var server-side for the panes created from here on.
export ENIGMA_DIR="$BASE_DIR"
tmux set-environment -g ENIGMA_DIR "$BASE_DIR" 2>/dev/null

# --- Initialize window/pane counters, joining existing session if present ---
if tmux has-session -t "$SESSION" 2>/dev/null; then
    win=$(( $(tmux list-windows -t "$SESSION" | wc -l) - 1 ))
    last_panes=$(tmux list-panes -t "$SESSION:$win" | wc -l)
    pane=$(( win * PANES_PER_WINDOW + last_panes ))
else
    win=0
    pane=0
fi

for code in "${FILTERED[@]}"; do

    entry="${MAP[$code]}"

    # --- Ignore invalid codes ---
    if [ -z "$entry" ]; then
        echo "Skipping unknown code: $code"
        continue
    fi

    dir="${entry%%|*}"
    rc="${entry##*|}"

    if [[ "$dir" = ~* ]]; then
        full_dir="${dir/#\~/$HOME}"
    elif [[ "$dir" = /* ]]; then
        full_dir="$dir"
    else
        full_dir="$BASE_DIR/$dir"
    fi
    full_rc="$full_dir/$rc"

    # --- Validation checks ---
    if [ ! -d "$full_dir" ]; then
        echo "Skipping $code → directory not found: $full_dir"
        continue
    fi

    if [ ! -f "$full_rc" ]; then
        echo "Skipping $code → rc file not found: $full_rc"
        continue
    fi

    # --- Skip if already running ---
    if pgrep -f "conky -c $rc" > /dev/null 2>&1; then
        echo "Skipping $code → already running (conky -c $rc)"
        continue
    fi

    # Wayland: uncomment to force conky onto its X11/XWayland backend
    # (native Wayland backend lacks the ARGB/click-through support these
    # widgets rely on); no-op on a real X11 session.
    # cmd="env WAYLAND_DISPLAY= XDG_SESSION_TYPE=x11 conky -c $rc"
    cmd="conky -c $rc"

    # --- New window every N panes ---
    if (( pane % PANES_PER_WINDOW == 0 )); then
        if (( pane == 0 )); then
            tmux new-session -d -s "$SESSION" -n "Conky-1" -c "$full_dir"
        else
            ((win++))
            tmux new-window -t "$SESSION:$win" -n "Conky-$((win+1))" -c "$full_dir"
        fi
        tmux send-keys -t "$SESSION:$win.0" "$cmd" C-m
        tmux select-pane -t "$SESSION:$win.0" -T "$rc"
    else
        tmux split-window -t "$SESSION:$win" -c "$full_dir"
        tmux select-layout -t "$SESSION:$win" tiled
        tmux send-keys -t "$SESSION:$win" "$cmd" C-m
        tmux select-pane -t "$SESSION:$win" -T "$rc"
    fi

    ((pane++))
done

# --- Bail if nothing valid was launched ---
if (( pane == 0 )); then
    echo "No valid codes provided. Nothing started."
    exit 1
fi

# --- Final layout cleanup ---
# pane-border-status is a per-window option (not session-wide in tmux), so it
# must be set on every window individually — set on just "$SESSION" only
# took effect on the session's currently active window.
for ((i=0; i<=win; i++)); do
    tmux select-layout -t "$SESSION:$i" tiled
    tmux set-window-option -t "$SESSION:$i" pane-border-status top
done

tmux attach-session -t "$SESSION"
