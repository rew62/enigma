-- enigma system widget - dual CPU tick graphs with Cairo column header
-- cpu1 rises above the upper split line; cpu2 falls below the lower.
-- v1 2026-07-04 @rew62

local HOME       = os.getenv("HOME") or ""
local ENIGMA_DIR = os.getenv("ENIGMA_DIR") or (HOME .. "/.conky/enigma")

conky.config = {
    update_interval = 1,
    double_buffer   = true,

    own_window            = true,
    own_window_type       = 'normal',
    own_window_title      = 'enigma-sys',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value  = 0,
    own_window_hints      = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    alignment = 'top_right',
    gap_x     = 175,
    gap_y     = 200,   -- C2 W3

    minimum_width  = 150,
    maximum_width  = 150,
    border_inner_margin = 2,
    border_outer_margin = 0,
    border_width        = 0,

    use_xft       = true,
    short_units   = true,
    font          = 'Rubik:size=10',
    default_color = 'ffffff',
    color2        = '2D9EEA',

    lua_load           = ENIGMA_DIR .. '/settings.lua ' .. ENIGMA_DIR .. '/scripts/loadall.lua',
    lua_startup_hook   = 'vars',
    lua_draw_hook_pre  = 'main',
    lua_mouse_hook     = 'mouse_hook',
}

conky.text = [[${lua_parse sys_height}]]
