-- vnstat-summary.rc - compact vnstat summary (Cairo renderer) for enigma
-- v1 2026-07-04 @rew62

local HOME       = os.getenv("HOME") or ""
local ENIGMA_DIR = os.getenv("ENIGMA_DIR") or (HOME .. "/.conky/enigma")

conky.config = {
    -- Window / positioning
    alignment          = 'top_right',
    gap_x              = 173,
    gap_y              = 618,
    minimum_width      = 154,
    maximum_width      = 154,
    minimum_height     = 115,

    -- Transparent background
    own_window         = true,
    own_window_type    = 'normal',
    own_window_title   = 'vnstat-summary',
    own_window_hints   = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_argb_visual = true,
    own_window_argb_value  = 0,
    own_window_colour  = '#000000',

    -- No borders / decorations
    draw_borders        = false,
    border_inner_margin = 2,
    draw_graph_borders  = false,
    border_width        = 0,
    border_inner_margin = 0,
    border_outer_margin = 0,

    -- Rendering
    double_buffer      = true,
    no_buffers         = true,
    update_interval    = 60,
    cpu_avg_samples    = 2,
    use_xft            = true,
    override_utf8_locale = true,

    -- Lua script
    lua_load           = ENIGMA_DIR .. '/settings.lua ' .. ENIGMA_DIR .. '/scripts/loadall.lua',
    lua_draw_hook_pre  = 'main',
    lua_startup_hook   = 'vars',
    lua_mouse_hook     = 'mouse_hook',
}

conky.text = [[ ]]
