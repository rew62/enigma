-- gcal.rc - 150px gcalcli calendar widget
-- v1 2026-07-04 @rew62

local HOME       = os.getenv("HOME") or ""
local ENIGMA_DIR = os.getenv("ENIGMA_DIR") or (HOME .. "/.conky/enigma")

conky.config = {
    -- ── window ──────────────────────────────────────────────────────────────
    alignment          = 'top_right',
    gap_x              = 5,
    gap_y              = 675,   -- col R w 4
    minimum_width      = 150,
    maximum_width      = 150,
    minimum_height     = 650,
    border_inner_margin = 2,
    border_outer_margin = 0,
    border_width        = 0,

    -- ── look ────────────────────────────────────────────────────────────────
    own_window         = true,
    own_window_type    = 'normal',
    own_window_title   = 'gcal',
    own_window_hints   = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_argb_visual = true,
    own_window_argb_value  = 0,

    double_buffer      = true,
    draw_shades        = false,
    draw_outline       = false,
    draw_borders       = false,

    -- ── fonts & colors ───────────────────────────────────────────────────────
    use_xft            = true,
    font               = 'Roboto:size=9',
    default_color      = 'aaccff',
    default_shade_color = '000000',

    -- ── timing ───────────────────────────────────────────────────────────────
    update_interval    = 600,             -- refresh every 10 minutes
    total_run_times    = 0,

    -- ── lua ──────────────────────────────────────────────────────────────────
    lua_load = ENIGMA_DIR .. '/settings.lua ' .. ENIGMA_DIR .. '/scripts/loadall.lua',
    lua_draw_hook_post = 'main',
    lua_startup_hook = 'vars',
    lua_mouse_hook = 'mouse_hook',
}

-- All drawing is done by Lua.
conky.text = [[
]]
