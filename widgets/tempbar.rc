-- tempbar.rc - 150px current conditions: location/update header + temp bar + emoji+desc
-- v1 2026-07-04 @rew62

local HOME       = os.getenv("HOME") or ""
local ENIGMA_DIR = os.getenv("ENIGMA_DIR") or (HOME .. "/.conky/enigma")

conky.config = {

    -- Window
    own_window             = true,
    own_window_type        = "normal",
    own_window_title       = "w-tempbar3",
    own_window_hints       = "undecorated,below,sticky,skip_taskbar,skip_pager",
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value  = 0,

    double_buffer          = true,
    no_buffers             = true,

    -- Size and position
    minimum_width          = 150,
    maximum_width          = 150,
    minimum_height         = 55,
    alignment              = "top_right",
    gap_x                  = 175,
    gap_y                  = 50,   -- C2, W1

    -- Text
    use_xft                = true,
    font                   = "Sans:size=9",
    xftalpha               = 1,
    default_color          = "ffffff",

    -- Performance
    update_interval        = 60,
    total_run_times        = 0,

    -- Drawing
    draw_shades            = false,
    draw_outline           = false,
    draw_borders           = false,
    draw_graph_borders     = false,
    border_inner_margin    = 2,
    border_outer_margin    = 0,
    border_width           = 0,

    -- Lua
    lua_load               = ENIGMA_DIR .. '/settings.lua ' .. ENIGMA_DIR .. '/scripts/loadall.lua',
    lua_startup_hook       = 'weather_update',
    lua_draw_hook_post     = 'main',
    lua_mouse_hook         = 'mouse_hook',

}

conky.text = [[

]]
