bars=20                              -- nr of bars must be set in cava-config!!! (needs a restart of conky)
max=1000                      		 -- max value of bars
cap="b "
x=70                          		 -- First bar vertical position
y=88                          		 -- Bars horizontal positions
barspaces=-1                  		 -- Spaces between bars
angle_bar=180                 		 -- Set angle of bar (make it circular)
radius=0                      		 -- Radius of the circle
fg_colour={0x00bbff,1}        		 -- Foreground color of activated blocks
bg_colour={0x227766,0}        		 -- Background color of deactived blocks
alarm_colour={0xff8700,1}     		 -- Gradient color to the max
smooth=true                   		 -- Smooth bars
blockspaces=.1                		 -- Space between the blocks
blocks=76                     		 -- Nr of blocks per bar
height=0.7                    		 -- Height of a block
width=14                      		 -- Width of a block
angle=0                       		 -- Angle of all bars
skew_x=0                      		 -- Skew bars (can be negative number)
skew_y=0                      		 -- Skew blocks (can be negative number)
reflection="b"                		 -- Position of the reflection
reflection_alpha=1            		 -- Alpha blend of reflection (0 to 1)
reflection_length=1           		 -- Length of reflection (0 to 1)
reflection_scale=1            		 -- Scale/stretch of reflection (can only be higher then 0)
