-- nowplaying.rc
-- Music Conky: Now Playing & Volume (with click events)
-- v1 2026-07-04 @rew62

local HOME       = os.getenv("HOME") or ""
local ENIGMA_DIR = os.getenv("ENIGMA_DIR") or (HOME .. "/.conky/enigma")

conky.config = {
    background = false,
    alignment = 'top_right',
    gap_x = 170,
    gap_y = 740,

    own_window = true,
    own_window_type = 'normal',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value = 0,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_title = 'nowplaying2',

    minimum_width = 154,
    maximum_width = 154,
    minimum_height = 294,
    border_inner_margin = 2,

    use_xft = true,
    font = 'Roboto:size=9',
    xftalpha = 1,
    uppercase = false,
    override_utf8_locale = true,

    draw_borders = false,
    draw_outline = false,
    draw_shades = false,
    draw_graph_borders = false,

    default_color = 'ffffff',
    default_shade_color = '#333333',
    default_outline_color = 'black',

    update_interval = 0.5,
    total_run_times = 0,
    double_buffer = true,
    no_buffers = true,
    cpu_avg_samples = 2,
    text_buffer_size = 4096,

    imlib_cache_flush_interval = 60,
    imlib_cache_size = 10000,

    -- Lua Scripts
    lua_load = ENIGMA_DIR .. '/settings.lua ./scripts/nowplaying-loadall.lua',
    lua_startup_hook   = 'vars',
    lua_draw_hook_pre  = 'conky_main',
    lua_mouse_hook     = 'mouse_hook',
};

conky.text = [[

]];
